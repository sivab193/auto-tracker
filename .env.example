# ============================================================================
# AutoTracker — environment configuration
# Copy this file to `.env` and adjust. Every value below has a sane default,
# so the stack boots even with an empty .env (SQLite + local storage, no bot).
# ============================================================================

# ---- General ----
APP_NAME=AutoTracker
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
# Set automatically by api/index.py on Vercel. Disables the alert scheduler and
# the Telegram polling thread, which need a long-lived process. Leave false for
# Docker / Render / local runs.
SERVERLESS=false
# Comma-separated list of allowed CORS origins for the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Auth ----
# When true, the API auto-authenticates as a single built-in owner and the
# login/registration flow is bypassed. Great for a personal, self-hosted setup.
SINGLE_USER=true
SINGLE_USER_EMAIL=owner@autotracker.local
SINGLE_USER_NAME=Owner
# CHANGE THIS in production. Used to sign JWTs.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ---- Database ----
# SQLite by default. Swap for postgres later:
#   DATABASE_URL=postgresql+psycopg://user:pass@db:5432/autotracker
DATABASE_URL=sqlite:///./data/autotracker.db

# ---- Object storage (MinIO / S3 / R2) ----
# If STORAGE_BACKEND=minio and a MinIO/S3 endpoint is reachable, files go there.
# Otherwise the app transparently falls back to local disk under LOCAL_STORAGE_DIR.
STORAGE_BACKEND=minio              # minio | local
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=autotracker
S3_SECURE=false                    # true when endpoint is https (e.g. real S3/R2)
S3_REGION=us-east-1
LOCAL_STORAGE_DIR=./data/storage

# ---- OCR ----
OCR_ENABLED=true
TESSERACT_CMD=tesseract            # path to tesseract binary, if not on PATH
OCR_LANGUAGES=eng                  # e.g. eng+deu

# ---- Telegram bot ----
# Leave TELEGRAM_BOT_TOKEN empty to disable the bot entirely.
TELEGRAM_BOT_TOKEN=
# Auto-delete sent documents after this many seconds (0 = never).
TELEGRAM_AUTODELETE_SECONDS=300
# Public base URL the bot uses to build temporary download links.
PUBLIC_BASE_URL=http://localhost:8000

# ---- Alerts / scheduler ----
SCHEDULER_ENABLED=true
# How many days before an expiry to start alerting.
ALERT_LEAD_DAYS=30,14,7,1
# Daily time (24h, server local) to run the expiry sweep.
ALERT_SWEEP_HOUR=8

# ---- Frontend (build-time) ----
# Leave empty to use relative /api (proxied to the backend by nginx in prod and
# by Vite in dev — no CORS). Set a full URL only for split-host deployments.
VITE_API_BASE_URL=
